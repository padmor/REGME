{
  "version": 2,
  "buildCommand": "node scripts/unpack-bundle.js",
  "installCommand": "npm install",
  "outputDirectory": "app/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "app/public/**"
    }
  }
}
